{
  "name": "@codepilot/minimatch-compat",
  "version": "1.0.0",
  "private": true,
  "description": "Legacy callable API adapter for the patched official minimatch engine",
  "main": "index.cjs",
  "exports": {
    ".": {
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "minimatch-engine": "npm:minimatch@11.0.1"
  },
  "engines": {
    "node": "18 || 20 || >=22"
  }
}
